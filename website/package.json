{
  "name": "@agent-conformance/website",
  "version": "0.0.1",
  "description": "The public website for the Agent Conformance standard (agent-conformance.org): landing page, documentation, and the canonical context, vocabulary, and JSON Schemas served at their IRIs.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://agent-conformance.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-conformance/agentce.git",
    "directory": "website"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ./scripts/build-iris.mjs && node ./scripts/build-llms.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:iri": "node ./scripts/check-iris.mjs",
    "check:hero": "node ./scripts/quickstart-hero.mjs",
    "check:install": "node ./scripts/check-install.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.1",
    "astro": "^7.2.10",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "playwright": "1.61.1"
  }
}
