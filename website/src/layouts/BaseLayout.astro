---
// The base layout for custom (non-documentation) pages such as the landing page. It provides the
// document shell — language, viewport, canonical and Open Graph metadata, the shared design tokens,
// and a header/footer — while the page supplies the <main> content through the default slot.
//
// The theme (light/dark) is kept in sync with the Starlight documentation: both read the same
// `starlight-theme` value and set `data-theme` on <html>, so a visitor's choice carries across the
// landing page and the docs. When nothing is stored, the palette follows the system preference.
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A deterministic, model-free, vendor-neutral standard for assessing how AI agents behave, with reproducible evidence.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-card.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-card.png', Astro.site)} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('starlight-theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* localStorage may be unavailable; fall back to the system preference. */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">
          <span class="mark" aria-hidden="true"></span>
          Agent&nbsp;Conformance
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/docs/getting-started/">Documentation</a>
          <a href="https://github.com/agent-conformance/agentce">GitHub</a>
          <span class="theme-toggle">
            <label class="visually-hidden" for="theme-select">Theme</label>
            <select id="theme-select" aria-label="Theme">
              <option value="dark">Dark</option>
              <option value="light">Light</option>
              <option value="auto" selected>Auto</option>
            </select>
          </span>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <script is:inline>
      (() => {
        const KEY = 'starlight-theme';
        const parse = (v) => (v === 'dark' || v === 'light' ? v : 'auto');
        const stored = () => {
          try {
            return parse(localStorage.getItem(KEY));
          } catch (e) {
            return 'auto';
          }
        };
        const resolve = (theme) =>
          theme === 'auto'
            ? matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark'
            : theme;
        const apply = (theme) => {
          document.documentElement.dataset.theme = resolve(theme);
          const select = document.getElementById('theme-select');
          if (select instanceof HTMLSelectElement) select.value = theme;
        };
        const store = (theme) => {
          try {
            localStorage.setItem('starlight-theme', theme === 'light' || theme === 'dark' ? theme : '');
          } catch (e) {
            /* localStorage may be unavailable. */
          }
        };
        apply(stored());
        matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
          if (stored() === 'auto') apply('auto');
        });
        const select = document.getElementById('theme-select');
        if (select) {
          select.addEventListener('change', (e) => {
            const theme = parse(e.currentTarget && e.currentTarget.value);
            store(theme);
            apply(theme);
          });
        }
      })();
    </script>
    <footer class="site-footer">
      <div class="bar">
        <p>An open standard for agent conformance. Apache-2.0 licensed.</p>
        <nav class="nav" aria-label="Footer">
          <a href="/docs/getting-started/">Docs</a>
          <a href="https://github.com/agent-conformance/agentce">Source</a>
          <a href="https://github.com/agent-conformance/agentce/blob/main/LICENSE">License</a>
        </nav>
      </div>
    </footer>

    <style>
      :global(html) {
        box-sizing: border-box;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        line-height: 1.6;
        -webkit-text-size-adjust: 100%;
      }
      :global(*),
      :global(*::before),
      :global(*::after) {
        box-sizing: inherit;
      }
      :global(body) {
        margin: 0;
        min-height: 100vh;
        background: var(--bg);
        display: flex;
        flex-direction: column;
      }
      :global(a) {
        color: var(--accent-strong);
      }
      :global(:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 3px;
      }
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--accent);
        color: var(--accent-contrast);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        z-index: 10;
      }
      .skip-link:focus {
        left: 1rem;
      }
      .bar {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-header {
        border-bottom: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        position: sticky;
        top: 0;
        backdrop-filter: blur(8px);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        color: var(--text);
        text-decoration: none;
      }
      .mark {
        width: 1.1rem;
        height: 1.1rem;
        border-radius: 4px;
        background: var(--accent);
        box-shadow: inset 0 0 0 3px var(--accent-contrast), 0 0 0 1px var(--accent-strong);
      }
      .nav {
        display: flex;
        gap: 1.25rem;
        align-items: center;
      }
      .nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.95rem;
      }
      .nav a:hover {
        color: var(--accent-strong);
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .theme-toggle select {
        font: inherit;
        font-size: 0.9rem;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 0.3rem 0.5rem;
      }
      main {
        flex: 1;
      }
      .site-footer {
        border-top: 1px solid var(--border);
        background: var(--bg-subtle);
        margin-top: 4rem;
      }
      .site-footer p {
        margin: 0;
        color: var(--text-faint);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
