---
// Landing page (/). The value narrative moves from the problem (agent behaviour can't be compared or
// trusted across vendors) to the consequence (unverifiable claims, risk carried into production) to the
// resolution (a shared, executable conformance standard that produces reproducible evidence). Copy is
// grounded in what the engine actually does; the terminal is generated from a real quickstart run (scripts/quickstart-hero.mjs).
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: 'Same verdict on every machine',
    body: 'No learned component decides an outcome. The same evidence and rules produce the same verdict on every run, on every machine.',
  },
  {
    title: 'It never guesses',
    body: 'The engine reads structured evidence and evaluates it against explicit rules. What it cannot verify, it reports as insufficient — it never guesses.',
  },
  {
    title: 'A result means the same everywhere',
    body: 'One specification and one control catalog. Agents and frameworks are assessed on the same terms, so a result means the same thing everywhere.',
  },
  {
    title: 'Reproduce it byte for byte',
    body: 'Reports have a canonical byte form. Independent engines in Python, TypeScript, and Java produce byte-identical assertions.json over the simulated corpus.',
  },
  {
    title: 'Check the evidence yourself',
    body: 'Implementation reports and catalogs are signed and content-addressed. Evidence checks out against its source — claims you can confirm, not take on faith.',
  },
  {
    title: 'Gate every change, offline',
    body: 'Scriptable, exit-code driven, and runnable with networking disabled. Assess an agent on every change before it reaches production.',
  },
];

const artifacts = [
  { name: 'assertions.json', note: 'one machine-readable verdict per control and subject — the source of truth' },
  { name: 'report.md · report.html', note: 'the human-readable report, each finding citing its evidence' },
  { name: 'results.sarif', note: 'findings in SARIF for code-scanning and CI surfaces' },
  { name: 'oscal-ar.json', note: 'an OSCAL Assessment Results rendering for GRC tooling' },
];

// The proof strip (Appendix A3): every differentiator claim on this page paired with a source a
// reader can actually follow, so "verifiable" is demonstrated on its own landing page rather than
// only asserted by it.
const proofStrip = [
  {
    claim: 'Model-free',
    note: '`agentce version --json` reports `no_ml: pass` — no learned component in the dependency tree.',
    href: '/reference/commands/version/',
  },
  {
    claim: 'Deterministic',
    note: 'The same evidence and rules produce the same verdict on a different machine, in a different engine.',
    href: '/docs/concepts/#why-it-is-deterministic-and-model-free',
  },
  {
    claim: 'Runs offline',
    note: 'No assessment reaches the network; CI gates every change with networking disabled.',
    href: '/docs/ci-integration/#run-offline-in-the-pipeline',
  },
  {
    claim: 'Signed & content-addressed',
    note: 'Every catalog, corpus, and release is signed and verified against its own digest.',
    href: '/explanation/verification/',
  },
  {
    claim: '≈130-project simulated corpus',
    note: 'Generated by a deterministic, seeded generator with known ground truth — not hand-picked examples.',
    href: 'https://github.com/agent-conformance/agentce/blob/main/corpus/README.md#full-corpus',
  },
  {
    claim: 'EU AI Act mapping',
    note: '60 controls across the base catalog and its overlays, one page per control.',
    href: '/reference/controls/',
  },
  {
    claim: 'Three engines, byte-identical',
    note: 'Python, TypeScript, and Java agree byte for byte on the conformance suite.',
    href: '/docs/running-assessments/',
  },
  {
    claim: 'A real quickstart tally',
    note: 'The tally of a real quickstart run — conformant, insufficient evidence, not assessed — is shown below and reproducible with one command.',
    href: '/docs/getting-started/',
  },
];

// The objections a skeptical adopter actually raises (Appendix A4), answered directly rather than
// restating the feature grid a second time.
const faqs = [
  {
    q: 'Is a conformant result a certification?',
    a: 'No. A conformant result means the engine checked specific evidence against a specific control and found it sufficient — nothing more. Certification is a legal and organizational process; this standard produces the evidence such a process would need, not the process itself.',
  },
  {
    q: 'Does the engine use a model to decide the outcome?',
    a: 'No. No learned component takes part in any verdict, in any engine — a dependency-denylist check enforces this on every change. The engine reads structured evidence and evaluates it against explicit rules; when the evidence does not meet a rule, the result is "insufficient evidence," never a guess.',
  },
  {
    q: 'Does an assessment need network access?',
    a: 'No. An assessment reads a local evidence bundle and a local catalog and needs nothing else. CI runs a dedicated job with networking disabled to prove it, on every change.',
  },
  {
    q: 'Is "deterministic" just marketing?',
    a: 'No — it is a tested property. The same evidence and rules produce byte-identical output regardless of machine, locale, clock, or which of the three conforming engines runs it; the determinism tests and the cross-engine comparison both run in CI.',
  },
];
---

<BaseLayout title="Agent Conformance — a standard for how AI agents behave">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">The open conformance standard for AI agents</p>
      <h1 id="hero-title">Assess any AI agent against the same standard.</h1>
      <p class="lede">
        For teams that build, buy, or audit agents: an engine that turns evidence into a verdict
        anyone can reproduce.
      </p>
      <div class="actions">
        <a class="button primary" href="/docs/getting-started/">Get started</a>
        <a class="button" href="https://github.com/agent-conformance/agentce">View on GitHub</a>
      </div>
      <p class="disclaimer">A conformant result is not a certification.</p>
      <div class="try-it">
        <p class="try-it-label">Copy it and run it yourself, offline:</p>
        <pre class="try-it-cmd"><code>$ agentce quickstart --out ./out</code></pre>
      </div>
    </div>

    <figure class="terminal" aria-label="Running an assessment with the command-line engine">
      <div class="terminal-bar" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      {/* quickstart-run:begin — generated by scripts/quickstart-hero.mjs, do not edit by hand */}
      <pre><code><span class="c-prompt">$</span> <span class="c-cmd">agentce quickstart --out ./out</span>
Verdict: Incomplete — no control failed, but not every applicable control is demonstrated.
Outcomes: conformant 25, non-conformant 0, partial 0, not applicable 0, not assessed 5, insufficient evidence 19
Top gaps:
  insufficient evidence: DAT-01, DAT-02, DAT-03, INC-01, INC-03 (+14 more gaps)
  not assessed: DAT-04, DOC-05, OVS-09, RSK-04, RSK-05
Next step: Supply the missing evidence, or complete the manual checks, for the controls listed under Top gaps, then run the assessment again. See report.md in ./out for every control.
quickstart complete: 49 assertions; report in ./out

<span class="c-prompt">$</span> <span class="c-cmd">head -n 21 out/report.md</span>
# AgentCE conformance report

## Verdict

**Incomplete — no control failed, but not every applicable control is demonstrated.**

Top gaps:

- insufficient evidence: DAT-01, DAT-02, DAT-03, INC-01, INC-03 (+14 more gaps)
- not assessed: DAT-04, DOC-05, OVS-09, RSK-04, RSK-05

Next step: Supply the missing evidence, or complete the manual checks, for the controls listed under Top gaps, then run the assessment again.

## Outcome summary

- conformant: 25
- non-conformant: 0
- partial: 0
- not applicable: 0
- not assessed: 5
- insufficient evidence: 19</code></pre>
      <figcaption>
        The real output of that command over the bundled <code>corpus/quickstart</code> project: 25 conformant, 19 insufficient evidence, 5 not assessed, of 49 controls.
        Insufficient evidence means a control applies and was evaluated, but the evidence collected did not meet its minimum;
        it is a gap in what was collected, not a failure and not a guess.
      </figcaption>
      {/* quickstart-run:end */}
    </figure>
  </section>

  <section class="band proof-strip" aria-labelledby="proof-title">
    <div class="inner">
      <h2 id="proof-title">Proof, not persuasion.</h2>
      <p class="band-lede">Every claim on this page links to the thing that makes it true — a command, a doc, or a source file, not another adjective.</p>
      <ul class="proof-list">
        {
          proofStrip.map((p) => (
            <li>
              <a href={p.href}>{p.claim}</a>
              <span>{p.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band narrative" aria-labelledby="why-title">
    <div class="inner">
      <h2 id="why-title">Agent behaviour is hard to compare, and harder to trust.</h2>
      <div class="narrative-grid">
        <div>
          <h3>The problem</h3>
          <p>
            Every framework describes its agent differently, and most evidence about how an agent
            actually behaved never leaves the vendor. There is no common way to ask whether two agents
            meet the same bar.
          </p>
        </div>
        <div>
          <h3>The consequence</h3>
          <p>
            Assurances become claims you cannot check. Risk that should be caught before release is
            carried into production, and obligations under frameworks like the EU AI Act are met on
            paper rather than in evidence.
          </p>
        </div>
        <div>
          <h3>The resolution</h3>
          <p>
            A shared, executable standard. The engine collects evidence about an agent, evaluates it
            against a public control catalog, and produces a report anyone can reproduce and verify —
            the same result, independently.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="features-title">
    <div class="inner">
      <h2 id="features-title">What you get once evidence replaces assurances.</h2>
      <ul class="feature-grid">
        {
          features.map((f) => (
            <li>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band artifacts" aria-labelledby="artifacts-title">
    <div class="inner">
      <h2 id="artifacts-title">One run, every rendering an adopter needs.</h2>
      <p class="band-lede">
        A single assessment writes the same evidence in the forms your tools already read — a machine
        verdict, a human report, and standard security and governance renderings.
      </p>
      <ul class="artifact-list">
        {
          artifacts.map((a) => (
            <li>
              <code>{a.name}</code>
              <span>{a.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band action" aria-labelledby="action-title">
    <div class="inner">
      <h2 id="action-title">See it in action.</h2>
      <p class="band-lede">
        Every finding in the human report cites a machine record behind it. Here is one real pair —
        the same control, from the same run — a human reads one side and a pipeline reads the other.
      </p>
      <div class="action-grid">
        <div class="human-excerpt">
          <h3>Human report excerpt — <code>report.md</code></h3>
          <pre><code>- **Consequential decisions record the data they consumed** (`DAT-01` @ `spiffe://corp/agents/credit-langgraph`) -&gt; **insufficient evidence** (rung 2, automated; 0/1 failed)
  - eu-ai-act Art. 10 (clause reference unverified)
  - Remediation: dat-evidence-at-source</code></pre>
        </div>
        <div class="machine-excerpt" aria-label="Machine record excerpt">
          <h3>Machine record — <code>assertions.json</code></h3>
          <pre><code>// assertions.json — one record of the run
{"{"}
  "control": "DAT-01",
  "family": "DAT",
  "outcome": "insufficient_evidence",
  "severity": "medium",
  "mode": "automated",
  "rung": 2,
  "subject": "spiffe://corp/agents/credit-langgraph",
  "population": {"{"} "applicable": 1, "failed": 0 {"}"},
  "crosswalk": [{"{"} "framework": "eu-ai-act", "clause": "Art. 10", "verified": false {"}"}]
{"}"}</code></pre>
        </div>
      </div>
      <p class="band-lede action-note">
        Both excerpts are from a real <code>agentce quickstart</code> run over the bundled example —
        not invented for this page. "Insufficient evidence" is a gap in what was collected, not a
        failure and not a guess.
      </p>
    </div>
  </section>

  <section class="band faq" aria-labelledby="faq-title">
    <div class="inner">
      <h2 id="faq-title">Frequently asked questions</h2>
      <dl class="faq-list">
        {
          faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band cta" aria-labelledby="cta-title">
    <div class="inner">
      <h2 id="cta-title">Assess your first agent in a few minutes.</h2>
      <p class="band-lede">
        Run the bundled example end to end, then point the engine at your own agent. Everything is open
        source and Apache-2.0 licensed.
      </p>
      <p class="band-lede cta-links">
        <a href="/docs/getting-started/">Read the docs</a> or <a href="https://github.com/agent-conformance/agentce">browse the source</a> — everything here is real, and yours to run.
      </p>
    </div>
  </section>

  <style>
    .inner {
      max-width: var(--measure);
      margin: 0 auto;
      padding: 0 var(--space-4);
    }
    .band {
      padding: var(--space-7) 0;
      border-top: 1px solid var(--border);
    }
    .band h2 {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3.5vw, 2.1rem);
      letter-spacing: -0.02em;
      margin: 0 0 var(--space-5);
      max-width: 24ch;
    }
    .band-lede {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 60ch;
      margin: -1rem 0 var(--space-5);
    }

    /* Hero */
    .hero {
      max-width: var(--measure);
      margin: 0 auto;
      padding: 4.5rem var(--space-4) var(--space-6);
      display: grid;
      gap: var(--space-6);
      grid-template-columns: 1fr;
      align-items: center;
    }
    @media (min-width: 60rem) {
      .hero {
        grid-template-columns: 1.05fr 0.95fr;
      }
    }
    .eyebrow {
      color: var(--accent-strong);
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.02em;
      margin: 0 0 var(--space-3);
    }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3.3rem);
      line-height: 1.08;
      letter-spacing: -0.025em;
      margin: 0 0 1.25rem;
      max-width: 18ch;
    }
    .lede {
      font-size: clamp(1.05rem, 2vw, 1.2rem);
      color: var(--text-muted);
      max-width: 60ch;
      margin: 0 0 var(--space-5);
    }
    .actions {
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
    }
    .disclaimer {
      margin: var(--space-3) 0 0;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .try-it {
      margin-top: var(--space-4);
    }
    .try-it-label {
      margin: 0 0 0.4rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .try-it-cmd {
      margin: 0;
      display: inline-block;
      padding: 0.6rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--bg-raised);
      font-family: var(--font-mono);
      font-size: 0.86rem;
      color: var(--text);
    }
    .button {
      display: inline-flex;
      align-items: center;
      padding: 0.7rem 1.3rem;
      border-radius: var(--radius);
      border: 1px solid var(--border-strong);
      color: var(--text);
      text-decoration: none;
      font-weight: 500;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }
    .button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-contrast);
    }
    .button:hover {
      border-color: var(--accent-strong);
    }
    .button.primary:hover {
      background: var(--accent-strong);
    }

    /* Terminal */
    .terminal {
      margin: 0;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-raised);
      box-shadow: 0 20px 45px -30px rgba(15, 23, 42, 0.55);
      overflow: hidden;
    }
    .terminal-bar {
      display: flex;
      gap: 0.4rem;
      padding: var(--space-2) var(--space-3);
      border-bottom: 1px solid var(--border);
      background: var(--bg-subtle);
    }
    .terminal-bar span {
      width: 0.7rem;
      height: 0.7rem;
      border-radius: 50%;
      background: var(--border-strong);
    }
    .terminal pre {
      margin: 0;
      padding: 1.25rem;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 0.86rem;
      line-height: 1.7;
      color: var(--text);
    }
    .terminal figcaption {
      padding: 0.85rem 1.25rem;
      border-top: 1px solid var(--border);
      background: var(--bg-subtle);
      font-size: 0.86rem;
      line-height: 1.6;
      color: var(--text-muted);
    }
    .terminal figcaption code {
      font-family: var(--font-mono);
      color: var(--text);
    }
    .c-prompt { color: var(--text-faint); }
    .c-cmd { color: var(--accent-strong); font-weight: 600; }

    /* Narrative */
    .narrative-grid {
      display: grid;
      gap: var(--space-5);
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
    .narrative-grid h3 {
      font-family: var(--font-display);
      font-size: 1.05rem;
      margin: 0 0 var(--space-1);
      color: var(--accent-strong);
    }
    .narrative-grid p {
      margin: 0;
      color: var(--text-muted);
    }

    /* Features */
    .feature-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.75rem 2.5rem;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
    .feature-grid h3 {
      font-family: var(--font-display);
      font-size: 1.15rem;
      margin: 0 0 var(--space-1);
    }
    .feature-grid p {
      margin: 0;
      color: var(--text-muted);
    }

    /* Artifacts */
    .artifacts {
      background: var(--bg-subtle);
    }
    .artifact-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-3);
    }
    .artifact-list li {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-1) var(--space-3);
      padding: var(--space-3) 1.25rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-raised);
    }
    .artifact-list code {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: var(--accent-strong);
      font-weight: 600;
    }
    .artifact-list span {
      color: var(--text-muted);
    }

    /* Proof strip */
    .proof-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-3);
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
    .proof-list li {
      padding: var(--space-3) 1.25rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-raised);
    }
    .proof-list a {
      display: block;
      font-weight: 600;
      color: var(--accent-strong);
      text-decoration: none;
      margin-bottom: 0.35rem;
    }
    .proof-list a:hover {
      text-decoration: underline;
    }
    .proof-list span {
      display: block;
      color: var(--text-muted);
      font-size: 0.92rem;
    }

    /* Show, don't tell */
    .action-grid {
      display: grid;
      gap: var(--space-4);
      grid-template-columns: 1fr;
      margin-bottom: var(--space-4);
    }
    @media (min-width: 60rem) {
      .action-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    .human-excerpt,
    .machine-excerpt {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-raised);
      overflow: hidden;
    }
    .human-excerpt h3,
    .machine-excerpt h3 {
      margin: 0;
      padding: 0.85rem 1.25rem;
      font-family: var(--font-display);
      font-size: 0.95rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg-subtle);
    }
    .human-excerpt h3 code,
    .machine-excerpt h3 code {
      font-family: var(--font-mono);
      color: var(--accent-strong);
    }
    .human-excerpt pre,
    .machine-excerpt pre {
      margin: 0;
      padding: 1.1rem 1.25rem;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      line-height: 1.6;
      color: var(--text);
      white-space: pre;
    }
    .action-note {
      margin: 0;
    }

    /* FAQ */
    .faq-list {
      margin: 0;
      display: grid;
      gap: var(--space-4);
    }
    .faq-item {
      border-top: 1px solid var(--border);
      padding-top: 1.25rem;
    }
    .faq-item:first-child {
      border-top: none;
      padding-top: 0;
    }
    .faq-item dt {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.05rem;
      margin: 0 0 var(--space-1);
    }
    .faq-item dd {
      margin: 0;
      color: var(--text-muted);
      max-width: 60ch;
    }

    /* CTA */
    .cta .inner {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cta-links {
      margin: 0;
    }
  </style>
</BaseLayout>
