@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix agentce: <https://agent-conformance.org/vocab/evidence/v1#> .

agentce:CND-02-Shape a sh:NodeShape ;
  sh:targetClass agentce:GatedAction ;
  sh:property [ sh:path agentce:gateMet ; sh:hasValue true ; sh:name "S1" ] .
