{
  "name": "@agent-conformance/cli",
  "version": "0.1.0",
  "description": "Agent Conformance Engine (AgentCE) reference engine and command-line interface (TypeScript).",
  "license": "Apache-2.0",
  "homepage": "https://agent-conformance.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-conformance/agentce.git",
    "directory": "engines/typescript"
  },
  "bugs": {
    "url": "https://github.com/agent-conformance/agentce/issues"
  },
  "bin": {
    "agentce": "bin/agentce.js"
  },
  "files": [
    "bin/",
    "dist/",
    "data/",
    "schema/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src bin",
    "format": "biome format --write src",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:cov": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=90 \"src/**/*.test.ts\"",
    "agentce": "tsx src/cli.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ai-agents",
    "conformance",
    "eu-ai-act",
    "oscal",
    "provenance",
    "shacl",
    "opentelemetry"
  ],
  "dependencies": {
    "ajv": "8.17.1",
    "decimal.js": "10.6.0",
    "js-yaml": "4.3.2",
    "n3": "2.7.12"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/js-yaml": "4.0.9",
    "@types/n3": "1.26.4",
    "@types/node": "22.7.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
