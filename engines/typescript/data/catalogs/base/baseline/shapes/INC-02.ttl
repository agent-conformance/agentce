@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix agentce: <https://agent-conformance.org/vocab/evidence/v1#> .

agentce:INC-02-Shape a sh:NodeShape ;
  sh:targetClass agentce:Incident ;
  sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:name "N1" ] .
