@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix agentce: <https://agent-conformance.org/vocab/evidence/v1#> .

agentce:DOC-01-Shape a sh:NodeShape ;
  sh:targetClass agentce:ComponentRecord ;
  sh:property [ sh:path agentce:componentDeclared ; sh:in ( true ) ; sh:name "S1" ] ;
  sh:property [ sh:path agentce:declaredComponentsObserved ; sh:in ( true ) ; sh:name "S2" ] .
