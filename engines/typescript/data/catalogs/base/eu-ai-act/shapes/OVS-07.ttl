@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix agentce: <https://agent-conformance.org/vocab/evidence/v1#> .

agentce:OVS-07-Shape a sh:NodeShape ;
  sh:targetClass agentce:Override ;
  sh:targetClass agentce:Interrupt ;
  sh:property [ sh:path agentce:interventionEffective ; sh:hasValue true ; sh:name "S1" ] ;
  sh:property [ sh:path agentce:interventionByHuman ; sh:hasValue true ; sh:name "S2" ] .
