{
  "$schema": "./argv-grammar.schema.json",
  "version": 1,
  "rules": [
    "global_flag_before_command",
    "version_alone",
    "help_after_command",
    "exact_spelling",
    "abbreviation",
    "short_cluster",
    "equals_value_with_spaces",
    "negative_number_after_equals",
    "double_dash_ends_options",
    "repeated_option",
    "repeatable_option_keeps_order",
    "needs_value",
    "needs_value_before_double_dash",
    "needs_value_before_option",
    "value_on_flag",
    "extra_positional",
    "double_dash_alone",
    "dash_token_not_option",
    "unknown_command"
  ],
  "globals": [
    {
      "names": [
        "--json"
      ],
      "kind": "flag",
      "repeatable": false
    },
    {
      "names": [
        "--debug"
      ],
      "kind": "flag",
      "repeatable": false
    },
    {
      "names": [
        "--quiet"
      ],
      "kind": "flag",
      "repeatable": false
    }
  ],
  "top": {
    "help": [
      "-h",
      "--help"
    ],
    "version": [
      "-V",
      "--version"
    ],
    "keys": {
      "unrecognized": "input.unknown_command"
    },
    "fixes": {
      "flag": "run `agentce --help` for the commands and global flags agentce takes.",
      "command": "run `agentce --help` for the commands agentce takes."
    }
  },
  "commands": {
    "validate": {
      "options": [
        {
          "names": [
            "--bundle"
          ],
          "kind": "value",
          "repeatable": false,
          "needs_value_key": "input.bundle_missing"
        },
        {
          "names": [
            "--out"
          ],
          "kind": "value",
          "repeatable": false
        }
      ],
      "positionals": {
        "min": 0,
        "max": 0
      },
      "keys": {
        "unrecognized": "input.validate_unrecognized_flag",
        "needs_value": "input.validate_unrecognized_flag"
      },
      "fixes": {
        "flag": "run `agentce validate --help` for the flags validate takes, or drop the flag.",
        "extra": "pass the bundle with its flag: `agentce validate --bundle <dir>`."
      },
      "implemented_in": [
        "python",
        "typescript",
        "java"
      ]
    },
