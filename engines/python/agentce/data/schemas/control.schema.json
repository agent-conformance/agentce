{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-conformance.org/spec/rules/control.schema.json",
  "title": "AgentCE control",
  "description": "One control of a catalog, expressed as a single YAML document (SPEC 7.1). A control declares how it applies, the minimum evidence and source class it requires, its expectations, and the rung of the correctness ladder at which it is evaluated. Structural expectations reference a Portable Shape Profile shape (psp.md); statistical and effectiveness expectations embed a metric or probe specification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "crosswalk",
    "applicability",
    "evaluation",
    "expectations",
    "severity",
    "evidence_strength",
    "test_cases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{2}$",
      "description": "Control identifier: family prefix and two-digit number (e.g. OVS-03)."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}$",
      "description": "Catalog version this control belongs to, as YYYY.MM."
    },
    "title": {"type": "string"},
    "description": {"type": "string"},
    "crosswalk": {
      "type": "array",
      "minItems": 1,
      "description": "Mappings to external frameworks; clause references only, never reproduced text (SPEC 7.3).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "clause", "relation"],
        "properties": {
          "framework": {
            "type": "string",
            "enum": ["eu-ai-act", "iso-42001", "nist-ai-rmf", "owasp-asi-2026", "aiuc-1"]
          },
          "clause": {"type": "string"},
          "relation": {"type": "string", "enum": ["implements", "supports", "maps", "mitigates"]},
          "verified_against_text": {
            "type": "boolean",
            "description": "Set true by a reviewer with access to the standard; unverified references are rendered as such (SPEC 7.3)."
          }
        }
      }
    },
    "interpretations": {
      "type": "array",
      "items": {"type": "string", "pattern": "^IR-[0-9]{2}$"},
      "description": "Interpretation register entries this control depends on (SPEC 6.10)."
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies_to_roles"],
      "properties": {
        "applies_to_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["deployer", "provider", "both"]},
          "description": "Roles the control applies to; see IR-11."
        },
        "when": {
          "type": "string",
          "description": "An applicability predicate resolved by the engine (e.g. a subClassOf test)."
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rung", "min_source_class", "minimum_evidence"],
      "properties": {
        "mode": {"type": "string", "enum": ["automated", "semi-automated", "manual"]},
        "rung": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 coverage, 1 integrity, 2 structural, 3 statistical, 4 semantic (SPEC 8.3)."
        },
        "min_source_class": {"$ref": "#/$defs/source_class"},
        "minimum_evidence": {
          "type": "array",
          "minItems": 1,
          "description": "Without this evidence the outcome is insufficient_evidence, never conformant.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "class"],
            "properties": {
              "event": {"type": "string"},
              "class": {"$ref": "#/$defs/source_class_or_any"}
            }
          }
        },
        "shape": {
          "type": "string",
          "description": "Path to the Portable Shape Profile shape for a rung-2 structural expectation."
        }
      }
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"}
        }
      }
    },
    "severity": {"type": "string", "enum": ["high", "medium", "low"]},
    "evidence_strength": {
      "type": "string",
      "enum": ["strong", "partial"],
      "description": "strong = operating effectiveness; partial = design only."
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "max"],
      "description": "Population-level tolerance; defaults to zero for severity high (SPEC 7.1, 9.2).",
      "properties": {
        "kind": {"type": "string", "enum": ["count", "ratio"]},
        "max": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "string", "pattern": "^0?\\.[0-9]+$", "description": "Ratio in [0,1) as a decimal string."}
          ]
        }
      }
    },
    "tolerance_rationale": {"type": "string"},
    "false_positive_modes": {"type": "array", "items": {"type": "string"}},
    "techniques": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Informative implementation-pattern references; never change an outcome (DC-10)."
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "fixture"],
        "properties": {
          "id": {"type": "string"},
          "expected": {
            "type": "string",
            "enum": ["passed", "failed", "inapplicable", "insufficient_evidence", "not_assessed"]
          },
          "fixture": {"type": "string"}
        }
      }
    },
    "remediation_hint": {"type": "string"},
    "metric": {"$ref": "metric.schema.json"},
    "probe": {"$ref": "probe.schema.json"},
    "checklist": {"$ref": "checklist.schema.json"}
  },
  "allOf": [
    {
      "description": "Automated rules must carry at least one passed, failed, and inapplicable test case (SPEC 7.1).",
      "if": {
        "properties": {"evaluation": {"properties": {"mode": {"const": "automated"}}, "required": ["mode"]}},
        "required": ["evaluation"]
      },
      "then": {
        "properties": {
          "test_cases": {
            "allOf": [
              {"contains": {"properties": {"expected": {"const": "passed"}}, "required": ["expected"]}},
              {"contains": {"properties": {"expected": {"const": "failed"}}, "required": ["expected"]}},
              {"contains": {"properties": {"expected": {"const": "inapplicable"}}, "required": ["expected"]}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "source_class": {
      "type": "string",
      "enum": ["self_report", "enforcement_point", "independent_system"]
    },
    "source_class_or_any": {
      "type": "string",
      "enum": ["self_report", "enforcement_point", "independent_system", "any"]
    }
  }
}
