@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix agentce: <https://agent-conformance.org/vocab/evidence/v1#> .

agentce:CND-06-Shape a sh:NodeShape ;
  sh:targetClass agentce:Instruction, agentce:PolicyDecision ;
  agentce:targetWhere [ agentce:refusalInScope true ] ;
  sh:property [ sh:path agentce:refusalMet ; sh:hasValue true ; sh:name "S1" ] .
