{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-conformance.org/spec/report/oscal-component-definition.schema.json",
  "title": "AgentCE OSCAL Component Definition (profile)",
  "description": "The subset of NIST OSCAL Component Definition that AgentCE publishes as oscal-component-definition.json (SPEC 2.1, 7.3): AgentCE described as a validation component whose control implementation targets the EU AI Act base catalog, one implemented requirement per control. This is a bounded profile authored with the standards-alignment work (item 5.5); it is generated from the catalog and validated by validate_oscal.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["component-definition"],
  "properties": {
    "component-definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uuid", "metadata", "components"],
      "properties": {
        "uuid": {"$ref": "#/$defs/uuid"},
        "metadata": {
          "type": "object",
          "required": ["title", "last-modified", "version", "oscal-version"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "last-modified": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "oscal-version": {"type": "string", "minLength": 1},
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "title": {"type": "string", "minLength": 1}
                }
              }
            },
            "parties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["uuid", "type", "name"],
                "properties": {
                  "uuid": {"$ref": "#/$defs/uuid"},
                  "type": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1}
                }
              }
            },
            "responsible-parties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["role-id", "party-uuids"],
                "properties": {
                  "role-id": {"type": "string", "minLength": 1},
                  "party-uuids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}}
                }
              }
            }
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uuid", "type", "title", "description", "control-implementations"],
            "properties": {
              "uuid": {"$ref": "#/$defs/uuid"},
              "type": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "props": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "value"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "value": {"type": "string"}
                  }
                }
              },
              "control-implementations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["uuid", "source", "description", "implemented-requirements"],
                  "properties": {
                    "uuid": {"$ref": "#/$defs/uuid"},
                    "source": {"type": "string", "minLength": 1},
                    "description": {"type": "string", "minLength": 1},
                    "implemented-requirements": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["uuid", "control-id", "description"],
                        "properties": {
                          "uuid": {"$ref": "#/$defs/uuid"},
                          "control-id": {"type": "string", "minLength": 1},
                          "description": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
