{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-conformance.org/spec/report/remediation-package.schema.json",
  "title": "AgentCE remediation package",
  "description": "remediation-package.json (SPEC §7; Appendix A2): a pure deterministic join, for one subject, of each non-passing control's catalog data (title, severity, crosswalk with its verified flag, expectation text, remediation techniques, minimum evidence) with that control's real assertion outcome (evidence, violations, evidence gap). No model call; RFC 8785 canonical; byte-identical across independent runs of the same assertions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "package_version", "generated_from", "subject", "findings", "not_assessed", "deviations_applied"],
  "properties": {
    "$schema": {"type": "string"},
    "$id": {"type": "string"},
    "package_version": {"type": "integer", "minimum": 1},
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertions_digest", "engine", "catalogs"],
      "properties": {
        "assertions_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["impl", "version", "spec_version"],
          "properties": {
            "impl": {"type": "string"},
            "version": {"type": "string"},
            "spec_version": {"type": "string"}
          }
        },
        "catalogs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "digest"],
            "properties": {
              "id": {"type": "string"},
              "version": {"type": "string"},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "subject": {"type": "string"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "not_assessed": {"type": "array", "items": {"$ref": "#/$defs/not_assessed_entry"}},
    "deviations_applied": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "class"],
      "properties": {
        "event": {"type": "string"},
        "class": {"type": "string"}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "clause", "relation", "verified_against_text"],
      "properties": {
        "framework": {"type": "string"},
        "clause": {"type": "string"},
        "relation": {"type": "string"},
        "verified_against_text": {"type": "boolean"}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "result"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "result": {"type": "string"}
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "path", "constraint", "message_key"],
      "properties": {
        "focus": {"type": "string"},
        "path": {"type": "string"},
        "constraint": {"type": "string"},
        "message_key": {"type": "string"}
      }
    },
    "evidence_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "source_class"],
      "properties": {
        "ref": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_class": {"type": "string", "enum": ["self_report", "enforcement_point", "independent_system"]}
      }
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "ref", "digest"],
      "properties": {
        "style": {"type": "string"},
        "ref": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control", "control_version", "outcome", "rung", "mode", "severity", "window", "title",
        "clauses", "expectations", "evidence_gap", "violations", "evidence", "remediation",
        "acceptance", "guardrails_ref"
      ],
      "properties": {
        "control": {"type": "string"},
        "control_version": {"type": "string"},
        "outcome": {"type": "string", "enum": ["non-conformant", "partial", "insufficient_evidence"]},
        "rung": {"type": "integer", "minimum": 0, "maximum": 4},
        "mode": {"type": "string"},
        "severity": {"type": "string", "enum": ["high", "medium", "low", "unrated"]},
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"}
          }
        },
        "title": {"type": "string"},
        "description": {"type": "string"},
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/clause"}},
        "expectations": {"type": "array", "items": {"$ref": "#/$defs/expectation"}},
        "evidence_gap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "observed", "missing"],
          "properties": {
            "required": {"type": "array", "items": {"$ref": "#/$defs/evidence_requirement"}},
            "observed": {"type": "array", "items": {"$ref": "#/$defs/evidence_requirement"}},
            "missing": {"type": "array", "items": {"$ref": "#/$defs/evidence_requirement"}}
          }
        },
        "violations": {"type": "array", "items": {"$ref": "#/$defs/violation"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_pointer"}},
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["techniques"],
          "properties": {
            "hint": {"type": "string"},
            "techniques": {"type": "array", "items": {"$ref": "#/$defs/technique"}}
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_transition", "criteria", "reverify_command"],
          "properties": {
            "expected_transition": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {"type": "string"},
                "to": {"type": "string"}
              }
            },
            "criteria": {"type": "string"},
            "reverify_command": {"type": "array", "items": {"type": "string"}}
          }
        },
        "guardrails_ref": {"type": "string"}
      }
    },
    "not_assessed_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "control_version", "title", "severity", "reason"],
      "properties": {
        "control": {"type": "string"},
        "control_version": {"type": "string"},
        "title": {"type": "string"},
        "severity": {"type": "string", "enum": ["high", "medium", "low", "unrated"]},
        "reason": {"type": "string"}
      }
    }
  }
}
