{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-conformance.org/spec/report/results-sarif.schema.json",
  "title": "AgentCE SARIF results (profile)",
  "description": "The subset of SARIF 2.1.0 that AgentCE emits as results.sarif (SPEC 9), so CI can gate on non-conformant controls with a format it already reads. This is a bounded profile validated in Phase 1; it conforms to the SARIF 2.1.0 structure for the fields it uses.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "runs"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "const": "2.1.0"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "results"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["driver"],
            "properties": {
              "driver": {
                "type": "object",
                "required": ["name", "rules"],
                "properties": {
                  "name": {"type": "string"},
                  "version": {"type": "string"},
                  "informationUri": {"type": "string"},
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id"],
                      "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
                    }
                  }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ruleId", "level", "message"],
              "properties": {
                "ruleId": {"type": "string"},
                "level": {"type": "string", "enum": ["none", "note", "warning", "error"]},
                "message": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}}
              }
            }
          }
        }
      }
    }
  }
}
