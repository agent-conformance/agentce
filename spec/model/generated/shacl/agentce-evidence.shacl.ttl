<https://agent-conformance.org/vocab/evidence/v1#ApprovalDecidedPayload> a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "approve" "edit" "reject" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#outcome> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#explanation_viewed> ],
        [ sh:datatype xsd:string ;
            sh:description "Source-specific extras; never evaluated by rules." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#ext> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#latency_ms> ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#session_ref> ],
        [ sh:class <https://agent-conformance.org/vocab/evidence/v1#IntegrityBlock> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#integrity> ],
        [ sh:class <https://agent-conformance.org/vocab/evidence/v1#Principal> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#actor> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#edits_ref> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#session_id> ],
        [ sh:class <https://agent-conformance.org/vocab/evidence/v1#Refs> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <https://agent-conformance.org/vocab/evidence/v1#refs> ],
        [ sh:class <https://agent-conformance.org/vocab/evidence/v1#AgentRef> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass <https://agent-conformance.org/vocab/evidence/v1#ApprovalDecidedPayload> .

