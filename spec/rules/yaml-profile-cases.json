{
  "$comment": "SPEC 8.7 YAML profile: the shared case table every engine's tests read (18.184u). Each case is refused with the file role's existing input.* key (exit 3) and a message ending '<rule> at line <line> (SPEC 8.7).', or read. A 'generate' case is built as described under 'generators'. duplicate_key is checked on the composed tree (the earliest repeating key's line); every other rule is lexical.",
  "message": "{prefix} is outside the YAML profile: {rule} at line {line} (SPEC 8.7).",
  "generators": {
    "block_map": "for i in 0..depth-2: '  '*i + 'k:' on its own line, then '  '*(depth-1) + 'k: v'",
    "block_seq": "for i in 0..depth-2: '  '*i + '-' on its own line, then '  '*(depth-1) + '- v'",
    "flow_seq": "'[' * depth + ']' * depth",
    "flow_map": "'{a: ' * (depth-1) + '{}' + '}' * (depth-1)",
    "mixed": "block_map of depth//2 whose last line is '  '*(depth//2-1) + 'k: ' + '[' * (depth-depth//2) + ']' * (depth-depth//2)",
    "indentless": "block_map of depth-1 whose last line is '  '*(depth-2) + 'k:', then '  '*(depth-2) + '- v' (a sequence at its key's indent)"
  },
  "non_string_key": "a plain key that is empty or fully matches: ~ | null|Null|NULL | true|True|TRUE|false|False|FALSE | [-+]?(0|[1-9][0-9_]*) | [-+]?0b[01_]+ | [-+]?0x[0-9a-fA-F_]+ | [-+]?[0-9][0-9_]*\\.[0-9_]*([eE][-+][0-9]+)? | \\.[0-9][0-9_]*([eE][-+][0-9]+)? | [-+]?\\.(inf|Inf|INF) | \\.(nan|NaN|NAN) | [0-9]{4}-[0-9]{2}-[0-9]{2} | the PyYAML timestamp form with a time; or a flow collection followed by ':'",
  "hints": {
    "anchor": "write the value out in full instead of using an anchor",
    "alias": "write the value out in full instead of using an alias",
    "merge_key": "write the merged keys out in full instead of using <<",
    "tag": "remove the tag; quote the value to keep it as text",
    "directive": "remove the directive line",
    "explicit_key": "write the key as a plain or quoted key followed by a colon",
    "second_document": "keep one document in the file and remove the extra --- or ... line",
    "tab": "replace the tab with spaces",
    "non_string_key": "quote the key to make it text",
    "duplicate_key": "write each key once",
    "yaml11_bool": "quote the value to keep it as text",
    "underscore_number": "quote the value to keep it as text, or write the number without _",
    "sexagesimal": "quote the value to keep it as text",
    "octal": "quote the value to keep it as text",
    "exponent_no_dot": "quote the value to keep it as text, or write the number with a dot and a sign (1.0e+3)",
    "leading_zero": "quote the value to keep it as text, or write the number without the leading zero",
    "exponent_no_sign": "quote the value to keep it as text, or give the exponent a sign (1.0e+3)",
    "flow_scalar_indicator_start": "quote the value to keep it as text",
    "flow_line_not_indented": "indent the line further than the key the list or mapping belongs to",
    "depth_over_100": "flatten the nesting to at most 100 levels"
  },
