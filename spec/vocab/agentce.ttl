@prefix agentce: <https://agent-conformance.org/vocab/evidence/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://agent-conformance.org/vocab/evidence/v1> a owl:Ontology ;
  rdfs:label "AgentCE evidence vocabulary" ;
  rdfs:comment "A PROV-O profile plus the glue relations AgentCE defines because no existing vocabulary carries them (SPEC 6.3)." ;
  owl:imports <http://www.w3.org/ns/prov> .

# ---------------------------------------------------------------------------------------------
# Node classes (SPEC 6.3). Activities, agents, and entities are profiled onto PROV-O.
# ---------------------------------------------------------------------------------------------
agentce:Agent a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; rdfs:label "Agent" .
agentce:Principal a owl:Class ; rdfs:subClassOf prov:Agent ; rdfs:label "Principal" .
agentce:HumanPrincipal a owl:Class ; rdfs:subClassOf agentce:Principal ; rdfs:label "Human principal" .
agentce:ServicePrincipal a owl:Class ; rdfs:subClassOf agentce:Principal ; rdfs:label "Service principal" .
agentce:Activity a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Activity" .
agentce:ContextItem a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Context item" .
agentce:Policy a owl:Class ; rdfs:label "Policy" .
agentce:PolicyDecision a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Policy decision" .
agentce:DelegationIssued a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Delegation issued" .
agentce:Bundle a owl:Class ; rdfs:label "Bundle" .
agentce:Component a owl:Class ; rdfs:label "Component" .
agentce:Attestation a owl:Class ; rdfs:label "Attestation" .
agentce:Decision a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Decision" .
agentce:ConsequentialDecision a owl:Class ; rdfs:subClassOf agentce:Decision ;
  rdfs:label "Consequential decision" ;
  rdfs:comment "A decision with legal or similarly significant effect on a natural person (IR-05)." .
agentce:OversightEvent a owl:Class ; rdfs:label "Oversight event" .
agentce:Outcome a owl:Class ; rdfs:label "Outcome" .
agentce:Incident a owl:Class ; rdfs:label "Incident" .
agentce:Notice a owl:Class ; rdfs:label "Notice" .
agentce:Instruction a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Instruction" .
agentce:Refusal a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Refusal" .
agentce:OversightModality a owl:Class ; rdfs:label "Oversight modality" .
# Operation event classes are activities the shapes target.
agentce:ToolCall a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Tool call" .
agentce:ModelCall a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Model call" .
agentce:ResourceAccess a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Resource access" .
agentce:MemoryRead a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Memory read" .
agentce:MemoryWrite a owl:Class ; rdfs:subClassOf agentce:Activity ; rdfs:label "Memory write" .
agentce:ComponentRecord a owl:Class ; rdfs:label "Component record" ;
  rdfs:comment "An engine-materialised type on every BundleLoaded, ToolCall and ModelCall node, so one shape can judge a subject's declared components against the ones it operates (DOC-01)." .

# ---------------------------------------------------------------------------------------------
# Glue relations (SPEC 6.3). Reused PROV-O relations (prov:wasAssociatedWith, prov:actedOnBehalfOf,
# prov:used, prov:wasGeneratedBy, prov:wasInformedBy) are not redefined here.
# ---------------------------------------------------------------------------------------------
agentce:authorizedBy a owl:ObjectProperty ; rdfs:label "authorized by" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:PolicyDecision .
agentce:delegatedVia a owl:ObjectProperty ; rdfs:label "delegated via" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:DelegationIssued .
agentce:chainVerified a owl:DatatypeProperty ; rdfs:label "chain verified" ;
  rdfs:domain agentce:DelegationIssued ; rdfs:range xsd:boolean .
agentce:executes a owl:ObjectProperty ; rdfs:label "executes" ;
  rdfs:domain agentce:ToolCall ; rdfs:range agentce:Decision .
agentce:oversightModality a owl:ObjectProperty ; rdfs:label "oversight modality" ;
  rdfs:domain agentce:Decision ; rdfs:range agentce:OversightModality .
agentce:reviewedBy a owl:ObjectProperty ; rdfs:label "reviewed by" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:OversightEvent .
agentce:approvedBy a owl:ObjectProperty ; rdfs:label "approved by" ;
  rdfs:subPropertyOf agentce:reviewedBy ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:OversightEvent .
agentce:overriddenBy a owl:ObjectProperty ; rdfs:label "overridden by" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:OversightEvent .
agentce:interruptedBy a owl:ObjectProperty ; rdfs:label "interrupted by" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:OversightEvent .
agentce:loadedBundle a owl:ObjectProperty ; rdfs:label "loaded bundle" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:Bundle .
agentce:attestedBy a owl:ObjectProperty ; rdfs:label "attested by" ;
  rdfs:domain agentce:Bundle ; rdfs:range agentce:Attestation .
agentce:resultedIn a owl:ObjectProperty ; rdfs:label "resulted in" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:Outcome .
agentce:notifiedBy a owl:ObjectProperty ; rdfs:label "notified by" ;
  rdfs:domain agentce:Decision ; rdfs:range agentce:Notice .
agentce:relatedIncident a owl:ObjectProperty ; rdfs:label "related incident" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:Incident .
agentce:sourceClass a owl:ObjectProperty ; rdfs:label "source class" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:SourceClass .
agentce:SourceClass a owl:Class ; rdfs:label "Source class" .
agentce:precededBy a owl:ObjectProperty ; rdfs:label "preceded by" ;
  rdfs:domain agentce:Decision ; rdfs:range agentce:Decision .
agentce:actsOn a owl:ObjectProperty ; rdfs:label "acts on" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:Instruction .
agentce:derivedFrom a owl:ObjectProperty ; rdfs:label "derived from" ;
  rdfs:domain agentce:Instruction ; rdfs:range prov:Entity .
agentce:withinScope a owl:DatatypeProperty ; rdfs:label "within scope" ;
  rdfs:domain agentce:Activity ; rdfs:range xsd:boolean .
agentce:refusedBy a owl:ObjectProperty ; rdfs:label "refused by" ;
  rdfs:domain agentce:Instruction ; rdfs:range agentce:Refusal .

# ---------------------------------------------------------------------------------------------
# Engine-materialised edges (SPEC 7.2 B3, Appendix B): computed by the graph builder so that
# shapes never traverse unbounded paths.
# ---------------------------------------------------------------------------------------------
agentce:chainTerminus a owl:ObjectProperty ; rdfs:label "chain terminus" ;
  rdfs:domain agentce:Activity ; rdfs:range agentce:Principal ;
  rdfs:comment "The root principal of a materialised delegation chain." .
agentce:executesConsequential a owl:DatatypeProperty ; rdfs:label "executes consequential" ;
  rdfs:domain agentce:ToolCall ; rdfs:range xsd:boolean .
agentce:oversightModalityMatchesDeclared a owl:DatatypeProperty ; rdfs:label "oversight modality matches declared" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean .
agentce:danglingRef a owl:DatatypeProperty ; rdfs:label "dangling reference" ;
  rdfs:domain agentce:Activity ; rdfs:range xsd:string ;
  rdfs:comment "A refs.* value that resolves to no ingested event." .
agentce:adverseOutcomeLinked a owl:DatatypeProperty ; rdfs:label "adverse outcome linked" ;
  rdfs:domain agentce:Outcome ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether an adverse outcome carries an inbound resultedIn edge from the decision it resulted from; vacuously true for a non-adverse outcome." .
agentce:explanationReconstructable a owl:DatatypeProperty ; rdfs:label "explanation reconstructable" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether a decision is notifiedBy a Notice and its own evidence chain resolves (no danglingRef), so the explanation the notice points at can be reconstructed." .
agentce:componentDeclared a owl:DatatypeProperty ; rdfs:label "component declared" ;
  rdfs:domain agentce:ComponentRecord ; rdfs:range xsd:boolean ;
  rdfs:comment "On a ToolCall or ModelCall: whether the tool or model it names is declared in one of its subject's BundleLoaded manifests and, when both state a version or digest, the call's matches one declared." .
agentce:declaredComponentsObserved a owl:DatatypeProperty ; rdfs:label "declared components observed" ;
  rdfs:domain agentce:ComponentRecord ; rdfs:range xsd:boolean ;
  rdfs:comment "On a BundleLoaded: whether every model and MCP server its manifest declares is exercised by a ToolCall or ModelCall of the same subject." .
agentce:triggersIncident a owl:DatatypeProperty ; rdfs:label "triggers incident" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether an Incident's related_refs name the decision, an Outcome that resulted from it, or a ToolCall that executed it." .
agentce:oversightCoverageComplete a owl:DatatypeProperty ; rdfs:label "oversight coverage complete" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the decision was reviewed by enough distinct human actors: two when its observed or declared oversight modality is dual_control, otherwise one." .
agentce:interventionEffective a owl:DatatypeProperty ; rdfs:label "intervention effective" ;
  rdfs:domain agentce:OversightEvent ; rdfs:range xsd:boolean ;
  rdfs:comment "On an Override: whether it names a recorded decision and records its replacement. On an Interrupt: whether a named mechanism halted or paused the agent." .
agentce:interventionByHuman a owl:DatatypeProperty ; rdfs:label "intervention by human" ;
  rdfs:domain agentce:OversightEvent ; rdfs:range xsd:boolean ;
  rdfs:comment "On an Override or Interrupt: whether its actor is a named human principal." .
agentce:incidentResponded a owl:DatatypeProperty ; rdfs:label "incident responded" ;
  rdfs:domain agentce:Incident ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether an Incident records its detection time and at least one response time (causal assessment, provider notification or report)." .
agentce:riskReviewed a owl:DatatypeProperty ; rdfs:label "risk reviewed" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the decision was reviewed, or its authorization names a PolicyDecision the bundle holds." .
agentce:authorizationHeld a owl:DatatypeProperty ; rdfs:label "authorization held" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether a held PolicyDecision gates the decision (the one its authorization names, or one whose request names it), none of them is a deny, and any authorization it carries names a held PolicyDecision by its IRI." .
agentce:authorizationGateCleared a owl:DatatypeProperty ; rdfs:label "authorization gate cleared" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the authorization is held and every PolicyDecision that gates the decision allowed it, or required approval and a human approved the decision." .
agentce:authorityRecorded a owl:DatatypeProperty ; rdfs:label "authority recorded" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the authorization is held and every PolicyDecision that gates the decision names its policy id, policy version and a sha256 policy digest." .
agentce:decisionDocumented a owl:DatatypeProperty ; rdfs:label "decision documented" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the decision records what it chose and, when it lists its options, the chosen value is the id of one of them." .
agentce:explanationTimed a owl:DatatypeProperty ; rdfs:label "explanation timed" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether an explanation Notice names the decision and was delivered at or after the decision's time, compared as instants." .
agentce:affectedPersonNotified a owl:DatatypeProperty ; rdfs:label "affected person notified" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether a Notice naming the decision records the person notified and its delivery time, and names the decision's own person when the decision names one." .
agentce:inDisclosureScope a owl:DatatypeProperty ; rdfs:label "in disclosure scope" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "False only when the decision records that it affects no natural person; a decision that does not say stays in scope." .
agentce:aiInteractionDisclosed a owl:DatatypeProperty ; rdfs:label "AI interaction disclosed" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether an ai_interaction Disclosure in the decision's session was delivered at or before the decision's time, compared as instants." .
agentce:inputsRecorded a owl:DatatypeProperty ; rdfs:label "inputs recorded" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the decision lists its inputs and every one is the graph IRI of a held record." .
agentce:dataConsumedRecorded a owl:DatatypeProperty ; rdfs:label "data consumed recorded" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether one of the decision's inputs is the graph IRI of a held MemoryRead or of a held ResourceAccess whose operation is read." .
agentce:aiRoleRecorded a owl:DatatypeProperty ; rdfs:label "AI role recorded" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the decision records the AI system's role in it: sole, recommendation or assist." .
agentce:classCorroborated a owl:DatatypeProperty ; rdfs:label "class corroborated" ;
  rdfs:domain agentce:ToolCall ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether an integrity block backs the call's source class: on an enforcement_point call at strength source_signed or export_anchored, on an independent_system call at any strength; false on any other class." .
agentce:effectClassified a owl:DatatypeProperty ; rdfs:label "effect classified" ;
  rdfs:domain agentce:ToolCall ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the call records its effect class: read, write, irreversible, external_communication, spend or physical." .
agentce:delegationInForce a owl:DatatypeProperty ; rdfs:label "delegation in force" ;
  rdfs:domain agentce:ToolCall ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether the call's delegation reference is the graph IRI of a held, verified DelegationIssued whose time is at or before the call's and whose expires is after it, compared as instants." .
agentce:securityRefsResolve a owl:DatatypeProperty ; rdfs:label "security references resolve" ;
  rdfs:domain agentce:ToolCall ; rdfs:range xsd:boolean ;
  rdfs:comment "Whether every authorization, delegation and instruction reference the call carries names a held PolicyDecision, DelegationIssued and Instruction respectively." .
agentce:linkedRecordsResolve a owl:DatatypeProperty ; rdfs:label "linked records resolve" ;
  rdfs:domain prov:Activity ; rdfs:range xsd:boolean ;
  rdfs:comment "On a ToolCall or Incident: whether the record has no dangling reference and neither has any held record it names (refs, used event references and an Incident's related_refs)." .
agentce:robustToUntrustedContent a owl:DatatypeProperty ; rdfs:label "robust to untrusted content" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "On a Decision: whether everything it used was trusted, through any number of hops -- no record it used was written untrusted, quarantined or blocked by the memory guard, or written with no trust or verdict from an untrusted provenance_origin_class; no read it used has trust_min untrusted or quarantined; and no instruction it acts on comes from an untrusted source class." .
agentce:untrustedContentRuledOn a owl:DatatypeProperty ; rdfs:label "untrusted content ruled on" ;
  rdfs:domain agentce:Decision ; rdfs:range xsd:boolean ;
  rdfs:comment "On a Decision: whether the memory guard ruled on everything it used, through any number of hops -- every read it used was reported by an enforcement point, every record it used is covered by an enforcement-point read carrying a trust_min or an enforcement-point write carrying a trust or guard verdict, and every ref it used is held in the bundle." .
