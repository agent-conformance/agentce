{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-conformance.org/schema/cyclonedx-1.5.profile.schema.json",
  "title": "CycloneDX 1.5 required-field profile",
  "description": "A self-contained structural profile of the CycloneDX 1.5 BOM schema (https://cyclonedx.org/docs/1.5/json/) covering the fields the AgentCE release SBOM emits: bomFormat, specVersion, version, metadata (timestamp, tools, root component) and the component list (type, name, version, bom-ref, purl, hashes, licenses). It enforces the constants, enumerations and formats CycloneDX 1.5 fixes, so a document that validates here is a well-formed CycloneDX 1.5 BOM for these fields. It deliberately does not vendor the upstream schema's external $refs (SPDX, JSF) so verification stays offline and deterministic (SPEC §8.7).",
  "type": "object",
  "additionalProperties": true,
  "required": ["bomFormat", "specVersion", "version", "metadata", "components"],
  "properties": {
    "bomFormat": {"const": "CycloneDX"},
    "specVersion": {"const": "1.5"},
    "serialNumber": {"type": "string", "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"},
    "version": {"type": "integer", "minimum": 1},
    "metadata": {
      "type": "object",
      "required": ["timestamp", "tools", "component"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "vendor": {"type": "string"},
              "name": {"type": "string"},
              "version": {"type": "string"}
            }
          }
        },
        "component": {"$ref": "#/$defs/component"}
      }
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": {"type": "string"},
          "dependsOn": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "enum": [
            "application", "framework", "library", "container", "platform",
            "operating-system", "device", "device-driver", "firmware", "file",
            "machine-learning-model", "data", "cryptographic-asset"
          ]
        },
        "bom-ref": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "purl": {"type": "string"},
        "supplier": {
          "type": "object",
          "properties": {"name": {"type": "string"}}
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "object",
            "oneOf": [
              {
                "required": ["license"],
                "properties": {
                  "license": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "string"},
                      "name": {"type": "string"}
                    }
                  }
                }
              },
              {
                "required": ["expression"],
                "properties": {"expression": {"type": "string"}}
              }
            ]
          }
        },
        "hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alg", "content"],
            "properties": {
              "alg": {
                "enum": ["MD5", "SHA-1", "SHA-256", "SHA-384", "SHA-512", "SHA3-256", "SHA3-512", "BLAKE2b-256", "BLAKE3"]
              },
              "content": {"type": "string", "pattern": "^[a-fA-F0-9]+$"}
            }
          }
        },
        "externalReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": {
              "type": {"type": "string"},
              "url": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
